---
import Layout from "../layouts/Layout.astro";
---

<Layout title="CLOT / FLOW" description="A one-mechanic clotting game.">
  <header class="chrome">
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1 id="title" class="title-flash">CLOT / FLOW</h1>
    <svg
      id="game"
      viewBox="0 0 1600 900"
      preserveAspectRatio="xMidYMid meet"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="wall-grad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#7a2b30"></stop>
          <stop offset="100%" stop-color="#2f0f13"></stop>
        </linearGradient>
        <radialGradient id="tissue-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ffd9a8" stop-opacity="0.5"></stop>
          <stop offset="100%" stop-color="#ffd9a8" stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="stain-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#5a0d14" stop-opacity="0.9"></stop>
          <stop offset="100%" stop-color="#5a0d14" stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="platelet-halo-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#fff3d6" stop-opacity="0.9"></stop>
          <stop offset="100%" stop-color="#fff3d6" stop-opacity="0"></stop>
        </radialGradient>
        <path
          id="platelet-shape"
          d="M 1,0 L 0.35,0.606 L -0.525,0.909 L -0.75,0 L -0.55,-0.953 L 0.325,-0.563 Z"
        ></path>
      </defs>

      <ellipse id="tissue" cx="1250" cy="450" rx="380" ry="260" fill="url(#tissue-grad)" opacity="0.2" />

      <path
        id="vessel-wall"
        d="M 0,350 Q 200,335 400,350 T 800,350 T 1200,350 T 1600,350 L 1600,550 Q 1400,565 1200,550 T 800,550 T 400,550 T 0,550 Z"
        fill="url(#wall-grad)"
      />
      <rect id="vessel-lumen" x="40" y="400" width="1520" height="100" rx="30" fill="#8a1420" opacity="0.8" />

      <circle id="blood-stain" cx="800" cy="600" r="0" fill="url(#stain-grad)" opacity="0" />
      <circle id="idle-glow" cx="800" cy="450" r="90" fill="#ff5b5b" opacity="0" />
      <circle id="clot-bulge" cx="800" cy="450" r="0" fill="#5c1b1b" opacity="0" />
      <g id="fibrin-group" stroke="#f2d9c8" stroke-width="2.5" fill="none" opacity="0.9"></g>

      <g id="wound-tear" transform="translate(800,450) scale(28)">
        <path d="M -0.4,-0.95 L -0.05,-0.85 L -0.201,-0.618 Z" fill="#3a0f14" opacity="0.9" />
        <path d="M 0.34,1.046 L 0.55,1.4 L 0.15,1.25 Z" fill="#3a0f14" opacity="0.9" />
        <path
          d="M 1,0 L 0.445,0.323 L 0.340,1.046 L -0.185,0.571 L -0.930,0.676 L -0.5,0 L -0.849,-0.617 L -0.201,-0.618 L 0.371,-1.141 L 0.469,-0.341 Z"
          fill="#170305"
        />
      </g>

      <circle id="seal-flash" cx="800" cy="450" r="0" fill="none" stroke="#fff3d6" stroke-width="3" opacity="0" />

      <g id="drip-group" fill="#8e1420"></g>
      <g id="rbc-group" fill="#c42b2b"></g>
      <g id="platelet-group"></g>
    </svg>
    <div id="outcome-overlay" class="overlay">
      <p id="outcome-word" class="outcome-word"></p>
      <p id="outcome-score" class="outcome-score"></p>
      <button id="reset-btn" type="button" aria-label="Play again">↻</button>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
