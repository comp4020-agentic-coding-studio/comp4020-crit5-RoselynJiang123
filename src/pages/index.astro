---
import Layout from "../layouts/Layout.astro";
import {
  COLOR_WALL_TOP,
  COLOR_WALL_BOTTOM,
  COLOR_TISSUE_GLOW,
  COLOR_STAIN,
  COLOR_PLATELET_HALO,
  COLOR_LUMEN_RECT,
  COLOR_WOUND_DARK,
  COLOR_WOUND_DARKEST,
  COLOR_SEAL_FLASH_STROKE,
  COLOR_DRIP,
  COLOR_RBC_FALLBACK,
  COLOR_RBC_CORE,
  COLOR_RBC_MID,
  COLOR_RBC_RIM,
  COLOR_RBC_BACK_NEAR,
  COLOR_RBC_BACK_FAR,
  PLATELET_SHAPE_PATH,
  TISSUE_ELLIPSE,
  VESSEL_WALL_PATH,
  VESSEL_LUMEN_RECT,
  WOUND_TEAR_SCALE,
  WOUND_X,
  WOUND_Y,
} from "../theme";
---

<Layout title="CLOT / FLOW" description="A one-mechanic clotting game.">
  <header class="chrome">
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1 id="title" class="title-flash">CLOT / FLOW</h1>
    <svg
      id="game"
      viewBox="0 0 1600 900"
      preserveAspectRatio="xMidYMid meet"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="wall-grad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color={COLOR_WALL_TOP}></stop>
          <stop offset="100%" stop-color={COLOR_WALL_BOTTOM}></stop>
        </linearGradient>
        <radialGradient id="tissue-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color={COLOR_TISSUE_GLOW} stop-opacity="0.5"></stop>
          <stop offset="100%" stop-color={COLOR_TISSUE_GLOW} stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="stain-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color={COLOR_STAIN} stop-opacity="0.9"></stop>
          <stop offset="100%" stop-color={COLOR_STAIN} stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="platelet-halo-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color={COLOR_PLATELET_HALO} stop-opacity="0.9"></stop>
          <stop offset="100%" stop-color={COLOR_PLATELET_HALO} stop-opacity="0"></stop>
        </radialGradient>
        <path id="platelet-shape" d={PLATELET_SHAPE_PATH}></path>
        <radialGradient id="rbc" cx="42%" cy="38%" r="62%">
          <stop offset="0%" stop-color={COLOR_RBC_CORE}></stop>
          <stop offset="45%" stop-color={COLOR_RBC_MID}></stop>
          <stop offset="100%" stop-color={COLOR_RBC_RIM}></stop>
        </radialGradient>
        <radialGradient id="rbc-back" cx="42%" cy="38%" r="62%">
          <stop offset="0%" stop-color={COLOR_RBC_BACK_NEAR}></stop>
          <stop offset="100%" stop-color={COLOR_RBC_BACK_FAR}></stop>
        </radialGradient>
      </defs>

      <ellipse
        id="tissue"
        cx={TISSUE_ELLIPSE.cx}
        cy={TISSUE_ELLIPSE.cy}
        rx={TISSUE_ELLIPSE.rx}
        ry={TISSUE_ELLIPSE.ry}
        fill="url(#tissue-grad)"
        opacity={TISSUE_ELLIPSE.opacity}
      />

      <path id="vessel-wall" d={VESSEL_WALL_PATH} fill="url(#wall-grad)" />
      <rect
        id="vessel-lumen"
        x={VESSEL_LUMEN_RECT.x}
        y={VESSEL_LUMEN_RECT.y}
        width={VESSEL_LUMEN_RECT.width}
        height={VESSEL_LUMEN_RECT.height}
        rx={VESSEL_LUMEN_RECT.rx}
        fill={COLOR_LUMEN_RECT}
        opacity={VESSEL_LUMEN_RECT.opacity}
      />

      <circle id="blood-stain" cx={WOUND_X} cy="600" r="0" fill="url(#stain-grad)" opacity="0" />
      <circle id="idle-glow" cx={WOUND_X} cy={WOUND_Y} r="90" fill="#ff5b5b" opacity="0" />
      <circle id="clot-bulge" cx={WOUND_X} cy={WOUND_Y} r="0" fill="#5c1b1b" opacity="0" />
      <g id="fibrin-group" stroke="#f2d9c8" stroke-width="2.5" fill="none" opacity="0.9"></g>

      <g id="wound-tear" transform={`translate(${WOUND_X},${WOUND_Y}) scale(${WOUND_TEAR_SCALE})`}>
        <path d="M -0.4,-0.95 L -0.05,-0.85 L -0.201,-0.618 Z" fill={COLOR_WOUND_DARK} opacity="0.9" />
        <path d="M 0.34,1.046 L 0.55,1.4 L 0.15,1.25 Z" fill={COLOR_WOUND_DARK} opacity="0.9" />
        <path
          d="M 1,0 L 0.445,0.323 L 0.340,1.046 L -0.185,0.571 L -0.930,0.676 L -0.5,0 L -0.849,-0.617 L -0.201,-0.618 L 0.371,-1.141 L 0.469,-0.341 Z"
          fill={COLOR_WOUND_DARKEST}
        />
      </g>

      <circle id="seal-flash" cx={WOUND_X} cy={WOUND_Y} r="0" fill="none" stroke={COLOR_SEAL_FLASH_STROKE} stroke-width="3" opacity="0" />

      <g id="drip-group" fill={COLOR_DRIP}></g>
      <g id="rbc-back-group" fill={COLOR_RBC_FALLBACK}></g>
      <g id="rbc-group" fill={COLOR_RBC_FALLBACK}></g>
      <g id="platelet-group"></g>
    </svg>
    <div id="outcome-overlay" class="overlay">
      <p id="outcome-word" class="outcome-word"></p>
      <p id="outcome-score" class="outcome-score"></p>
      <button id="reset-btn" type="button" aria-label="Play again">↻</button>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
