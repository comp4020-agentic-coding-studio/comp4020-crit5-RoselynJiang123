---
import Layout from "../layouts/Layout.astro";
import {
  COLOR_TISSUE_GLOW,
  COLOR_STAIN,
  COLOR_PLATELET_HALO,
  COLOR_SEAL_FLASH_STROKE,
  COLOR_DRIP,
  COLOR_PLUME_NEAR,
  COLOR_PLUME_FAR,
  COLOR_POOL,
  COLOR_RBC_FALLBACK,
  COLOR_RBC_CORE,
  COLOR_RBC_MID,
  COLOR_RBC_OUTER,
  COLOR_RBC_RIM,
  COLOR_RBC_BACK_NEAR,
  COLOR_RBC_BACK_FAR,
  PLATELET_SHAPE_PATH,
  TISSUE_ELLIPSE,
  COLOR_LUMEN_FILL,
  COLOR_WALL_STROKE,
  WALL_STROKE_WIDTH,
  COLOR_ENDOTHELIUM,
  ENDOTHELIUM_STROKE_WIDTH,
  ENDOTHELIUM_OPACITY,
  COLOR_VIGNETTE,
  VIGNETTE_OPACITY,
  WALL_TOP_PATH,
  LUMEN_PATH,
  COLOR_BREACH_INTERIOR,
  COLOR_TORN_LIP,
  COLOR_BREACH_GLOW,
  COLOR_HEALING_SEAM,
  HEALING_SEAM_STROKE_WIDTH,
  WOUND_X,
  WOUND_Y,
  VIEW_W,
  VIEW_H,
  COLOR_IDLE_GLOW,
  IDLE_GLOW_RADIUS,
  COLOR_CLOT_MASS_TOP,
  COLOR_CLOT_MASS_MID,
  COLOR_CLOT_MASS_BOTTOM,
  CLOT_MASS_OPACITY,
  SEAL_FLASH_STROKE_WIDTH,
  STAIN_Y_OFFSET,
  COLOR_FIBRIN,
  FIBRIN_STROKE_WIDTH,
  FIBRIN_GROUP_OPACITY,
} from "../theme";
---

<Layout title="CLOT / FLOW" description="A one-mechanic clotting game.">
  <header class="chrome">
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1 id="title" class="title-flash">CLOT / FLOW</h1>
    <svg
      id="game"
      viewBox="0 0 1600 900"
      preserveAspectRatio="xMidYMid meet"
      aria-hidden="true"
    >
      <defs>
        <clipPath id="lumen-clip">
          <path d={LUMEN_PATH}></path>
        </clipPath>
        <radialGradient id="vignette-grad" cx="50%" cy="50%" r="70%">
          <stop offset="40%" stop-color={COLOR_VIGNETTE} stop-opacity="0"></stop>
          <stop offset="100%" stop-color={COLOR_VIGNETTE} stop-opacity={VIGNETTE_OPACITY}></stop>
        </radialGradient>
        <radialGradient id="tissue-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color={COLOR_TISSUE_GLOW} stop-opacity="0.5"></stop>
          <stop offset="100%" stop-color={COLOR_TISSUE_GLOW} stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="stain-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color={COLOR_STAIN} stop-opacity="0.9"></stop>
          <stop offset="100%" stop-color={COLOR_STAIN} stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="platelet-halo-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color={COLOR_PLATELET_HALO} stop-opacity="0.5"></stop>
          <stop offset="100%" stop-color={COLOR_PLATELET_HALO} stop-opacity="0"></stop>
        </radialGradient>
        <path id="platelet-shape" d={PLATELET_SHAPE_PATH}></path>
        <radialGradient id="rbc" cx="47%" cy="45%" r="56%">
          <stop offset="0%" stop-color={COLOR_RBC_CORE}></stop>
          <stop offset="42%" stop-color={COLOR_RBC_MID}></stop>
          <stop offset="72%" stop-color={COLOR_RBC_OUTER}></stop>
          <stop offset="100%" stop-color={COLOR_RBC_RIM}></stop>
        </radialGradient>
        <radialGradient id="rbc-back" cx="47%" cy="45%" r="56%">
          <stop offset="0%" stop-color={COLOR_RBC_BACK_NEAR}></stop>
          <stop offset="100%" stop-color={COLOR_RBC_BACK_FAR}></stop>
        </radialGradient>
        <radialGradient id="plume" cx="50%" cy="6%" r="60%">
          <stop offset="0%" stop-color={COLOR_PLUME_NEAR} stop-opacity="0.85"></stop>
          <stop offset="40%" stop-color={COLOR_PLUME_FAR} stop-opacity="0.35"></stop>
          <stop offset="100%" stop-color={COLOR_PLUME_FAR} stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="breach-glow-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color={COLOR_BREACH_GLOW} stop-opacity="0.9"></stop>
          <stop offset="100%" stop-color={COLOR_BREACH_GLOW} stop-opacity="0"></stop>
        </radialGradient>
        <linearGradient id="clotMass" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color={COLOR_CLOT_MASS_TOP}></stop>
          <stop offset="58%" stop-color={COLOR_CLOT_MASS_MID}></stop>
          <stop offset="100%" stop-color={COLOR_CLOT_MASS_BOTTOM}></stop>
        </linearGradient>
      </defs>

      <ellipse
        id="tissue"
        cx={TISSUE_ELLIPSE.cx}
        cy={TISSUE_ELLIPSE.cy}
        rx={TISSUE_ELLIPSE.rx}
        ry={TISSUE_ELLIPSE.ry}
        fill="url(#tissue-grad)"
        opacity={TISSUE_ELLIPSE.opacity}
      />

      <circle id="breach-glow" cx={WOUND_X} cy={WOUND_Y} r="0" fill="url(#breach-glow-grad)" opacity="0" />

      <path id="vessel-lumen" d={LUMEN_PATH} fill={COLOR_LUMEN_FILL} />

      <g clip-path="url(#lumen-clip)">
        <g id="rbc-back-group" fill={COLOR_RBC_FALLBACK}></g>
        <g id="rbc-group" fill={COLOR_RBC_FALLBACK}></g>
      </g>

      <path
        d={WALL_TOP_PATH}
        fill="none"
        stroke={COLOR_WALL_STROKE}
        stroke-width={WALL_STROKE_WIDTH}
        stroke-linecap="round"
      />
      <path
        id="wall-bottom-left"
        fill="none"
        stroke={COLOR_WALL_STROKE}
        stroke-width={WALL_STROKE_WIDTH}
        stroke-linecap="round"
      />
      <path
        id="wall-bottom-right"
        fill="none"
        stroke={COLOR_WALL_STROKE}
        stroke-width={WALL_STROKE_WIDTH}
        stroke-linecap="round"
      />
      <path
        d={WALL_TOP_PATH}
        fill="none"
        stroke={COLOR_ENDOTHELIUM}
        stroke-width={ENDOTHELIUM_STROKE_WIDTH}
        opacity={ENDOTHELIUM_OPACITY}
      />
      <path
        id="endo-bottom-left"
        fill="none"
        stroke={COLOR_ENDOTHELIUM}
        stroke-width={ENDOTHELIUM_STROKE_WIDTH}
        opacity={ENDOTHELIUM_OPACITY}
      />
      <path
        id="endo-bottom-right"
        fill="none"
        stroke={COLOR_ENDOTHELIUM}
        stroke-width={ENDOTHELIUM_STROKE_WIDTH}
        opacity={ENDOTHELIUM_OPACITY}
      />
      <path id="breach-interior" fill={COLOR_BREACH_INTERIOR} />
      <path id="breach-lip-left" fill={COLOR_TORN_LIP} />
      <path id="breach-lip-right" fill={COLOR_TORN_LIP} />
      <path id="healing-seam" fill="none" stroke={COLOR_HEALING_SEAM} stroke-width={HEALING_SEAM_STROKE_WIDTH} stroke-linecap="round" opacity="0" />

      <circle id="blood-stain" cx={WOUND_X} cy={WOUND_Y + STAIN_Y_OFFSET} r="0" fill="url(#stain-grad)" opacity="0" />
      <ellipse id="bleed-pool" cx={WOUND_X} cy={WOUND_Y} rx="0" ry="0" fill={COLOR_POOL} opacity="0" />
      <g id="bleed-group">
        <path id="bleed-plume" fill="url(#plume)" opacity="0" />
      </g>
      <circle id="idle-glow" cx={WOUND_X} cy={WOUND_Y} r={IDLE_GLOW_RADIUS} fill={COLOR_IDLE_GLOW} opacity="0" />
      <path id="clot-bulge" fill="url(#clotMass)" opacity={CLOT_MASS_OPACITY} />
      <g id="platelet-pile"></g>
      <g id="fibrin-group" stroke={COLOR_FIBRIN} stroke-width={FIBRIN_STROKE_WIDTH} fill="none" opacity={FIBRIN_GROUP_OPACITY}></g>

      <circle id="seal-flash" cx={WOUND_X} cy={WOUND_Y} r="0" fill="none" stroke={COLOR_SEAL_FLASH_STROKE} stroke-width={SEAL_FLASH_STROKE_WIDTH} opacity="0" />

      <g id="drip-group" fill={COLOR_DRIP}></g>
      <g id="platelet-group" clip-path="url(#lumen-clip)"></g>
      <g id="platelet-held-layer"></g>

      <rect
        x="0"
        y="0"
        width={VIEW_W}
        height={VIEW_H}
        fill="url(#vignette-grad)"
        pointer-events="none"
      />
    </svg>
    <div id="outcome-overlay" class="overlay">
      <p id="outcome-word" class="outcome-word"></p>
      <p id="outcome-score" class="outcome-score"></p>
      <button id="reset-btn" type="button" aria-label="Play again">↻</button>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
